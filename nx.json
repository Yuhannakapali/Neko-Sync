{
  "extends": "nx/presets/npm.json",
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "nxCloudAccessToken": "",
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": [
          "build",
          "test",
          "test-coverage",
          "lint",
          "vet",
          "deps",
          "security"
        ]
      }
    }
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "cache": true
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js"
      ],
      "cache": true
    },
    "test-coverage": {
      "dependsOn": ["deps"],
      "cache": true
    },
    "lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore"
      ],
      "cache": true
    },
    "vet": {
      "dependsOn": ["deps"],
      "cache": true
    },
    "serve": {
      "dependsOn": ["deps"]
    },
    "dev": {
      "dependsOn": ["deps"]
    },
    "docker-build": {
      "dependsOn": ["build"]
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/**/*_test.go",
      "!{projectRoot}/**/testdata/**/*",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.js",
      "!{projectRoot}/coverage.out",
      "!{projectRoot}/coverage.html",
      "!{projectRoot}/bin/**/*"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/.env",
      "{workspaceRoot}/.env.example",
      "{workspaceRoot}/makefile",
      "{workspaceRoot}/Dockerfile",
      "{workspaceRoot}/docker-compose.yml"
    ]
  },
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true
      }
    },
    "@nx/next": {
      "application": {
        "style": "css"
      }
    }
  }
}