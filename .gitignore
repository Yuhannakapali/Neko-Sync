# ==============================================================================
# Neko-Sync Monorepo .gitignore
# ==============================================================================

# ==============================================================================
# Node.js / Frontend (Next.js, React)
# ==============================================================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Next.js
.next/
out/
build/

# Nx
.nx/cache
.nx/workspace-data

# Logs
logs
*.log

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# ==============================================================================
# Go Backend
# ==============================================================================

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Go workspace file
go.work

# Air (hot reload) temporary files
tmp/
air_tmp/

# Binary output directories
/bin/
bin/
/dist/
dist/
apps/backend/bin/
apps/*/bin/

# Executable files (Go binaries)
nekosync
nekosync-*
*.bin

# Platform-specific executables
*-linux-amd64
*-darwin-amd64
*-darwin-arm64
*-windows-amd64.exe

# Any file without extension in common binary directories
bin/nekosync*
bin/*/
dist/nekosync*
apps/backend/nekosync*
apps/backend/cmd/nekosync/nekosync*

# All files in bin directories
bin/**
**/bin/**

# Executable bit files (common patterns)
*.app
*.com
*.command
*.run

# ==============================================================================
# Database
# ==============================================================================

# SQLite
*.db
*.sqlite
*.sqlite3

# PostgreSQL
*.sql
dumps/

# ==============================================================================
# Development Tools
# ==============================================================================

# IDE and Editor files
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Qodo (AI coding assistant)
.qodo/

# ==============================================================================
# Docker
# ==============================================================================

# Docker volumes
docker-compose.override.yml

# ==============================================================================
# CI/CD
# ==============================================================================

# Coverage reports
coverage/
*.cover
*.coverage

# Test results
test-results/
test-reports/

# ==============================================================================
# Temporary and Cache Files
# ==============================================================================

# Temporary files
*.tmp
*.temp
temp/
tmp/

# Cache directories
.cache/
.npm/
.yarn/
.pnpm-store/

# Build artifacts
dist/
build/
out/

# ==============================================================================
# Secrets and Keys
# ==============================================================================

# API keys and secrets
.secrets
*.key
*.pem
*.p12
*.crt

# JWT secrets
jwt.key

# ==============================================================================
# Backup files
# ==============================================================================

*.bak
*.backup
*.old

# ==============================================================================
# Package manager lock files (optional - uncomment if needed)
# ==============================================================================

# package-lock.json  # Uncomment if using yarn exclusively
# yarn.lock          # Uncomment if using npm exclusively
# pnpm-lock.yaml     # Uncomment if not using pnpm