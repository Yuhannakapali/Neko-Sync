# Neko-Sync Instance settings. Copy to .env or export in your shell.
NEKO_ADDR=:8787
NEKO_DB_PATH=./data/instance.db
NEKO_FFPROBE=ffprobe
NEKO_SCAN_ON_START=true

# Libraries: "Name:kind:/absolute/path" separated by ";". Kind is movie, series, or anime.
NEKO_LIBRARIES=Movies:movie:/media/movies;TV:series:/media/tv;Anime:anime:/media/anime
