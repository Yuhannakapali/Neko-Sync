{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/backend",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/bin"
      ],
      "options": {
        "command": "go build -o bin/nekosync ./cmd/nekosync",
        "cwd": "apps/backend"
      },
      "configurations": {
        "production": {
          "command": "CGO_ENABLED=0 go build -ldflags='-s -w' -o bin/nekosync ./cmd/nekosync",
          "cwd": "apps/backend"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "air",
        "cwd": "apps/backend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test ./...",
        "cwd": "apps/backend"
      }
    },
    "test-coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test -v -race -coverprofile=coverage.out ./... && go tool cover -html=coverage.out -o coverage.html",
        "cwd": "apps/backend"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "golangci-lint run",
        "cwd": "apps/backend"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go fmt ./...",
        "cwd": "apps/backend"
      }
    },
    "deps": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go mod download && go mod tidy",
        "cwd": "apps/backend"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -t nekosync-backend:latest -f ../../Dockerfile .",
        "cwd": "apps/backend"
      }
    },
    "migrate-up": {
      "executor": "nx:run-commands",
      "options": {
        "command": "migrate -path ../../scripts -database $DATABASE_URL up",
        "cwd": "apps/backend"
      }
    },
    "migrate-down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "migrate -path ../../scripts -database $DATABASE_URL down 1",
        "cwd": "apps/backend"
      }
    }
  },
  "tags": [
    "scope:backend",
    "type:app"
  ]
}